# The agent study raw runs: every file here is evidence for a published number,
# so the generic rules above (*.log, *.txt, build/) must not reach into it.
# The directory has to be re-included before the files inside it can be.
!experiments/agentstudy/runs/**/build/
!experiments/agentstudy/runs/**/*.log
!experiments/agentstudy/runs/**/*.jsonl
!experiments/agentstudy/runs/**/*.txt
!experiments/agentstudy/runs/**/*.tcl
!experiments/agentstudy/runs/**/*.v
!experiments/agentstudy/runs/**/*.sv
!experiments/agentstudy/runs/**/*.rpt

# macOS finder metadata, swept in by a subagent commit
.DS_Store
**/.DS_Store
